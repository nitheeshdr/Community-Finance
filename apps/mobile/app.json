{
  "expo": {
    "name": "Community Finance",
    "slug": "community-finance",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "communityfinance",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.setupsworks.finance"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A2E33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.setupsworks.finance",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#984447",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://finance-village-web.vercel.app",
      "router": {},
      "eas": {
        "projectId": "583178c9-c233-400f-abb2-d9bc5ed12e63"
      }
    },
    "owner": "nitheeshdr"
  }
}
